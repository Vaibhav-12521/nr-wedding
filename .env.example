# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ------------------------------------
# Public: safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET: server only. Bypasses row-level security - never prefix with NEXT_PUBLIC_,
# never paste into client code, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site -------------------------------------------------------------------
# The public address of the site (used in invitation emails, share links and redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: timezone used to display event times (default Asia/Kolkata).
# NEXT_PUBLIC_WEDDING_TIMEZONE=Asia/Kolkata

# Optional: your Supabase plan's storage limit in GB, for the admin storage gauge
# (Free = 1, Pro = 100 included).
# STORAGE_QUOTA_GB=100
